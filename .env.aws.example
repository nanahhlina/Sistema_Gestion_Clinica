APP_NAME="Vida Salud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO-O-URL-ELASTIC-BEANSTALK

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=vida_salud,public
DB_SSLMODE=require

# Para una sola instancia, file funciona. Si escalas a varias instancias y ya tienes
# la tabla vida_salud.sessions creada, cambia SESSION_DRIVER a database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
